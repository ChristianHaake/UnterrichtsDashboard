{
  "name": "unterrichtsdashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ein lokal-first Classroom-Management-Dashboard für den Beamer- und Tafeleinsatz im Präsenzunterricht.",
  "license": "GPL-3.0-only",
  "homepage": "https://unterrichtsdashboard.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristianHaake/UnterrichtsDashboard.git"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "i18next": "^25.0.0",
    "markdown-it": "^14.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^1.5.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.20.0",
    "@types/react-grid-layout": "^1.3.5",
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
